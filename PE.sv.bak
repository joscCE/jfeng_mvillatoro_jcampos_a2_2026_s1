module pe #(
	parameter string TRACE_FILE = ""
)(
	input logic clk, rst,
	input logic done,
	
	output logic req_valid,
	output logic req_type,
	output logic [4:0] addr,
	output logic [31:0] data,
	output logic finished
);
	typedef enum logic [1:0] {
		START,
		SEND_REQ,
		WAIT_DONE,
		END
	} state_t;
	
	state_t state;
	
	logic [37:0] trace_mem [0:255];
	int pc;
	
	initial begin
		$readmemh(TRACE_FILE, trace_mem);
	end
	
	always_ff @(posedge clk or posedge rst) begin
		if (rst) begin
			state     <= START;
			pc        <= 0;
			req_valid <= 0;
			req_type  <= 0;
			addr      <= 5'd0;
			data      <= 32'd0;
			finished  <= 0;
		end else begin
		
			case (state) 
			
				START: begin
					req_valid <= 0;
               finished  <= 0;
               pc        <= 0;
               state     <= SEND_REQ;
            end
				
				SEND_REQ: begin
					// detectar fin
					if (trace_mem[pc][31:0] == 32'hDEAD) begin
						state <= END;
					end else begin
						req_valid <= 1;
						req_type  <= trace_mem[pc][37];
						addr      <= trace_mem[pc][36:32];
						data      <= trace_mem[pc][31:0];
						state     <= WAIT_DONE;
					end
				end
				
				WAIT_DONE: begin
					req_valid <= 0;
					
					if (done) begin
						pc    <= pc + 1;
						state <= SEND_REQ;
					end 
				end
						
				END: begin
					   req_valid <= 0;
                  req_type  <= 0;
                  addr      <= 5'd0;
						data      <= 32'd0;
                  finished  <= 1;
				end
			endcase
		end
	end
	
endmodule		